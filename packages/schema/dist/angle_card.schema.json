{
  "$comment": "GENERATED by newsab_schema.export — do not edit. Definition site: packages/schema/newsab_schema/ | blueprint §2.4 / §3.3 S5 / §4.6 | status: draft",
  "$defs": {
    "LangText": {
      "additionalProperties": false,
      "description": "A free-text field with its language, per §1.6's hard rule.",
      "properties": {
        "lang": {
          "maxLength": 16,
          "minLength": 2,
          "title": "Lang",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "lang"
      ],
      "title": "LangText",
      "type": "object"
    },
    "NotablePhrase": {
      "additionalProperties": false,
      "description": "A wording worth showing the reader, anchored to where it was used.",
      "properties": {
        "gloss": {
          "anyOf": [
            {
              "$ref": "#/$defs/LangText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "phrase": {
          "minLength": 1,
          "title": "Phrase",
          "type": "string"
        },
        "sentence_id": {
          "title": "Sentence Id",
          "type": "string"
        }
      },
      "required": [
        "phrase",
        "sentence_id"
      ],
      "title": "NotablePhrase",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "``{skill_version, model_id, run_id, timestamp}`` (§3.2, §4.1).\n\n``model_id`` is ``None`` for purely deterministic producers (A1, scripts): recording\n\"no model was involved\" is itself an audit fact, and D10 makes it a meaningful one.",
      "properties": {
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "skill_version": {
          "pattern": "^[A-Za-z0-9]+-\\d+\\.\\d+\\.\\d+$",
          "title": "Skill Version",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "skill_version",
        "run_id",
        "timestamp"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One side's reading of one angle, in that side's own language (§3.3 S5).\n\nDeliberately *not* comparative: the card says what the sampled coverage on this side\ndoes, and nothing about the other side.  The comparison happens once, in S7, in the\npivot language — that is what D6 buys, and writing \"unlike the Chinese coverage…\" here\nwould smuggle the comparison into a stage that never read the other side.",
  "properties": {
    "angle_id": {
      "title": "Angle Id",
      "type": "string"
    },
    "card_id": {
      "pattern": "^CARD-[a-z0-9-]+-\\d{4}-[a-z]{2,5}$",
      "title": "Card Id",
      "type": "string"
    },
    "caveat": {
      "anyOf": [
        {
          "$ref": "#/$defs/LangText"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "clusters_supporting": {
      "minimum": 0,
      "title": "Clusters Supporting",
      "type": "integer"
    },
    "clusters_total": {
      "minimum": 0,
      "title": "Clusters Total",
      "type": "integer"
    },
    "evidence": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "group_id": {
      "pattern": "^[a-z]{2,5}$",
      "title": "Group Id",
      "type": "string"
    },
    "is_silence_card": {
      "default": false,
      "title": "Is Silence Card",
      "type": "boolean"
    },
    "lang": {
      "minLength": 2,
      "title": "Lang",
      "type": "string"
    },
    "notable_language": {
      "items": {
        "$ref": "#/$defs/NotablePhrase"
      },
      "title": "Notable Language",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "stance_summary": {
      "$ref": "#/$defs/LangText"
    },
    "structured_summary": {
      "$ref": "#/$defs/LangText"
    },
    "topic_id": {
      "title": "Topic Id",
      "type": "string"
    }
  },
  "required": [
    "card_id",
    "topic_id",
    "angle_id",
    "group_id",
    "lang",
    "stance_summary",
    "structured_summary",
    "evidence",
    "clusters_supporting",
    "clusters_total",
    "provenance"
  ],
  "title": "AngleCard",
  "type": "object"
}

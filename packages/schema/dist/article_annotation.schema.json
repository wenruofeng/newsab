{
  "$comment": "GENERATED by newsab_schema.export — do not edit. Definition site: packages/schema/newsab_schema/ | blueprint §4.2.3 | status: settled",
  "$defs": {
    "LanguageSignal": {
      "description": "``article_annotation.notable_language[].signal`` (§4.2.3).\n\nDescriptive labels for *wording*, never verdicts about the underlying facts (D4).",
      "enum": [
        "high_emotion",
        "euphemism",
        "metaphor",
        "epithet",
        "intensifier",
        "hedge",
        "official_formula",
        "other"
      ],
      "title": "LanguageSignal",
      "type": "string"
    },
    "NotableLanguage": {
      "additionalProperties": false,
      "description": "A wording signal, anchored to the sentence it occurs in.",
      "properties": {
        "phrase": {
          "minLength": 1,
          "title": "Phrase",
          "type": "string"
        },
        "sentence": {
          "title": "Sentence",
          "type": "string"
        },
        "signal": {
          "$ref": "#/$defs/LanguageSignal"
        }
      },
      "required": [
        "phrase",
        "sentence",
        "signal"
      ],
      "title": "NotableLanguage",
      "type": "object"
    },
    "OverallStance": {
      "additionalProperties": false,
      "description": "Article-level stance toward a named target, always with a confidence.\n\n§2.2's C6 also mentions a sentiment axis, which §4.2.3 no longer carries.  We follow\n§4.2.3; if sentiment comes back it is an additive field\nhere, not a change to anything already stored.",
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "polarity": {
          "$ref": "#/$defs/StancePolarity"
        },
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "target",
        "polarity",
        "confidence"
      ],
      "title": "OverallStance",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "``{skill_version, model_id, run_id, timestamp}`` (§3.2, §4.1).\n\n``model_id`` is ``None`` for purely deterministic producers (A1, scripts): recording\n\"no model was involved\" is itself an audit fact, and D10 makes it a meaningful one.",
      "properties": {
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "skill_version": {
          "pattern": "^[A-Za-z0-9]+-\\d+\\.\\d+\\.\\d+$",
          "title": "Skill Version",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "skill_version",
        "run_id",
        "timestamp"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "StancePolarity": {
      "description": "``stance.polarity`` (§4.2.1) and ``article_annotation.overall_stance`` (§4.2.3).",
      "enum": [
        "support",
        "oppose",
        "neutral",
        "ambivalent"
      ],
      "title": "StancePolarity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The light per-article record that runs alongside the observations (§4.2.3).",
  "properties": {
    "article_id": {
      "title": "Article Id",
      "type": "string"
    },
    "notable_language": {
      "items": {
        "$ref": "#/$defs/NotableLanguage"
      },
      "title": "Notable Language",
      "type": "array"
    },
    "overall_stance": {
      "anyOf": [
        {
          "$ref": "#/$defs/OverallStance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "topic_id": {
      "title": "Topic Id",
      "type": "string"
    }
  },
  "required": [
    "article_id",
    "topic_id",
    "provenance"
  ],
  "title": "ArticleAnnotation",
  "type": "object"
}

{
  "$comment": "GENERATED by newsab_schema.export — do not edit. Definition site: packages/schema/newsab_schema/ | blueprint §4.4 | status: settled",
  "$defs": {
    "AngleMetrics": {
      "additionalProperties": false,
      "description": "The statistics block of an angle: the triple ``(p_a, p_b, Δ interval)`` and its\nreadings (R-2.1).\n\n``prevalence`` is required — Δ alone cannot distinguish consensus from co-silence, so\nan artifact carrying only the difference is a design error by definition.\n``concentration`` (the old source diversity) is displayed, never gated.",
      "properties": {
        "a1_run_id": {
          "title": "A1 Run Id",
          "type": "string"
        },
        "concentration": {
          "$ref": "#/$defs/GroupMetric"
        },
        "conservative_effect": {
          "maximum": 2.0,
          "minimum": 0.0,
          "title": "Conservative Effect",
          "type": "number"
        },
        "delta": {
          "$ref": "#/$defs/DeltaInterval"
        },
        "direction_stability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Direction Stability",
          "type": "number"
        },
        "log_odds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Log Odds"
        },
        "prevalence": {
          "$ref": "#/$defs/GroupMetric"
        },
        "resampling": {
          "$ref": "#/$defs/ResamplingSpec"
        }
      },
      "required": [
        "prevalence",
        "delta",
        "direction_stability",
        "conservative_effect",
        "concentration",
        "resampling",
        "a1_run_id"
      ],
      "title": "AngleMetrics",
      "type": "object"
    },
    "AngleOrigin": {
      "description": "D9: recorded for audit, and forbidden from entering any threshold branch.",
      "enum": [
        "prior_hypothesis",
        "data_discovered"
      ],
      "title": "AngleOrigin",
      "type": "string"
    },
    "AngleStatus": {
      "description": "State machine from §4.4's ``selection.status`` comment.",
      "enum": [
        "proposed",
        "r_rejected",
        "r_passed",
        "merged",
        "clustered",
        "e_rejected",
        "shortlisted",
        "g2_approved",
        "g2_rejected"
      ],
      "title": "AngleStatus",
      "type": "string"
    },
    "AngleType": {
      "description": "The §3.3 A1 angle types, plus the special-cased blind spot (§4.1).\n\nThese are **labels**, not scan domains (R-3): every bare/attr feature is\nscanned identically, the structural types describe what a feature compares, and\n``shared_ground`` / ``co_silence`` name interval *readings* (consensus, joint silence)\nrather than shapes.  ``co_silence`` is an additive extension of the locked vocabulary:\nboth sides leaving a controlled-vocabulary cell empty is data, not a gap (D5).",
      "enum": [
        "salience",
        "problem_definition",
        "consequence",
        "voice_structure",
        "actor_role",
        "stance",
        "terminology",
        "shared_ground",
        "co_silence",
        "blind_spot"
      ],
      "title": "AngleType",
      "type": "string"
    },
    "BlindSpotCheck": {
      "additionalProperties": false,
      "description": "The four opportunity-to-cover conditions (§3.3 S6), each answered explicitly.\n\nNamed rather than lettered so a failure message says which check failed instead of\n\"(b)\".  All four must pass before a blind-spot angle may be shortlisted (§4.4.1\ninvariant 2) — blind spots carry a higher bar than every other angle type.",
      "properties": {
        "category_composition": {
          "$ref": "#/$defs/BlindSpotCondition"
        },
        "not_single_wire_amplified": {
          "$ref": "#/$defs/BlindSpotCondition"
        },
        "opportunity_to_cover": {
          "$ref": "#/$defs/BlindSpotCondition"
        },
        "same_event_stage": {
          "$ref": "#/$defs/BlindSpotCondition"
        }
      },
      "required": [
        "same_event_stage",
        "opportunity_to_cover",
        "category_composition",
        "not_single_wire_amplified"
      ],
      "title": "BlindSpotCheck",
      "type": "object"
    },
    "BlindSpotCondition": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "note": {
          "$ref": "#/$defs/LangText"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "passed",
        "note"
      ],
      "title": "BlindSpotCondition",
      "type": "object"
    },
    "Comparison": {
      "additionalProperties": false,
      "properties": {
        "feature": {
          "$ref": "#/$defs/Feature"
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/GroupComparison"
          },
          "minItems": 2,
          "title": "Groups",
          "type": "array"
        }
      },
      "required": [
        "feature",
        "groups"
      ],
      "title": "Comparison",
      "type": "object"
    },
    "DeltaInterval": {
      "additionalProperties": false,
      "description": "The signed prevalence difference ``p(group_a) − p(group_b)`` with its resampling\npercentile interval (R-2).\n\nNo p-values anywhere (D16): the interval is a robustness statement about the sample —\n\"would this difference survive had we been handed a different batch of clusters\" —\nnever an inference about a population.  ``group_a``/``group_b`` make the sign\nconvention explicit in the artifact rather than implied by list order.",
      "properties": {
        "group_a": {
          "title": "Group A",
          "type": "string"
        },
        "group_b": {
          "title": "Group B",
          "type": "string"
        },
        "hi": {
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Hi",
          "type": "number"
        },
        "level": {
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Level",
          "type": "number"
        },
        "lo": {
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Lo",
          "type": "number"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "value": {
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "group_a",
        "group_b",
        "value",
        "lo",
        "hi",
        "level",
        "method"
      ],
      "title": "DeltaInterval",
      "type": "object"
    },
    "Dimension": {
      "description": "Generic framing-analysis coding dimensions (S3 layer 1 / S4 track 1).",
      "enum": [
        "problem_definition",
        "responsibility",
        "consequence",
        "stance",
        "proposed_response",
        "actor_role",
        "quoted_voice",
        "terminology",
        "factual_claim"
      ],
      "title": "Dimension",
      "type": "string"
    },
    "EScore": {
      "additionalProperties": false,
      "description": "Editorial score, one 0–2 per axis against a published rubric (§3.3 S6, four axes\nsince R-7 — see ``E_SCORE_AXES`` for what was cut and why).\n\nEditorial scoring happens strictly after the R-gate and can only ever *remove*\ncandidates — there is no field here that can raise a candidate past a failed gate (D8).\nIts two remaining uses: the audit trail of the subjective selection, and the\nregression signal for R-6's δ calibration.",
      "properties": {
        "non_redundancy": {
          "maximum": 2,
          "minimum": 0,
          "title": "Non Redundancy",
          "type": "integer"
        },
        "relevance": {
          "maximum": 2,
          "minimum": 0,
          "title": "Relevance",
          "type": "integer"
        },
        "rubric_version": {
          "minLength": 1,
          "title": "Rubric Version",
          "type": "string"
        },
        "story_potential": {
          "maximum": 2,
          "minimum": 0,
          "title": "Story Potential",
          "type": "integer"
        },
        "surprise": {
          "maximum": 2,
          "minimum": 0,
          "title": "Surprise",
          "type": "integer"
        }
      },
      "required": [
        "surprise",
        "relevance",
        "non_redundancy",
        "story_potential",
        "rubric_version"
      ],
      "title": "EScore",
      "type": "object"
    },
    "Editorial": {
      "additionalProperties": false,
      "description": "The reader-facing question this angle becomes (§3.3 S6's highest-value LLM step).",
      "properties": {
        "e_score": {
          "anyOf": [
            {
              "$ref": "#/$defs/EScore"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "question": {
          "$ref": "#/$defs/MultiLangText"
        },
        "recommended_visual": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecommendedVisual"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "question"
      ],
      "title": "Editorial",
      "type": "object"
    },
    "Feature": {
      "additionalProperties": false,
      "description": "What the angle compares: one dimension, narrowed by a concept or by an attribute.\n\n``concept_id`` is absent for ``salience`` angles, which compare how much a dimension is\ntalked about at all rather than any single concept within it.\n\n``attr_key`` / ``attr_value`` extend §4.4's example, which shows only\n``{dimension, concept_id}``.  Two of the eight A1 scans are not concept comparisons at\nall: voice structure compares ``speaker_category`` and actor role compares ``actor``,\nboth of which live in an observation's ``attrs`` (§4.2.1).  Without this pair those\nscans would have to smuggle an attribute value into ``concept_id``, which would break\nthe ontology join.  The addition is optional and additive: a feature that omits it\nserialises exactly as the blueprint writes it.",
      "properties": {
        "attr_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attr Key"
        },
        "attr_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attr Value"
        },
        "concept_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Concept Id"
        },
        "dimension": {
          "$ref": "#/$defs/Dimension"
        }
      },
      "required": [
        "dimension"
      ],
      "title": "Feature",
      "type": "object"
    },
    "GroupComparison": {
      "additionalProperties": false,
      "description": "One side's counts for the feature, overall and split by source category.\n\n``by_category`` may hold ``None`` for a category that exists in the source registry but\nhas too few clusters to compare — §1.5 requires that to be *stated*, not silently\nfolded into another category.",
      "properties": {
        "by_category": {
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/SupportCount"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "By Category",
          "type": "object"
        },
        "clusters_supporting": {
          "minimum": 0,
          "title": "Clusters Supporting",
          "type": "integer"
        },
        "clusters_total": {
          "minimum": 0,
          "title": "Clusters Total",
          "type": "integer"
        },
        "group_id": {
          "pattern": "^[a-z]{2,5}$",
          "title": "Group Id",
          "type": "string"
        }
      },
      "required": [
        "group_id",
        "clusters_supporting",
        "clusters_total"
      ],
      "title": "GroupComparison",
      "type": "object"
    },
    "GroupMetric": {
      "additionalProperties": false,
      "description": "A metric with one value per group (source diversity).\n\nThe blueprint's example writes this flat (``{us: 0.81, cn: 0.64, method: ...}``); we\nstore it nested so a group can never collide with the reserved ``method`` key, and\naccept the flat form on input so blueprint-shaped YAML still loads.",
      "properties": {
        "by_group": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "By Group",
          "type": "object"
        },
        "method": {
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "by_group",
        "method"
      ],
      "title": "GroupMetric",
      "type": "object"
    },
    "IntervalReading": {
      "description": "The five readings of a signed-difference interval (R-2.2).\n\n``insufficient`` is a first-class outcome: \"the sample cannot tell\" is a different\nstatement from \"we checked and there is no difference\", and an earlier gate\nsilently conflated them.  An interval merely covering zero is evidence of nothing\n(G-5); ``consensus`` and ``co_silence`` require the whole interval inside an\nequivalence band, with different bands because Var ∝ p(1−p).",
      "enum": [
        "divergence",
        "small_stable_difference",
        "consensus",
        "co_silence",
        "insufficient"
      ],
      "title": "IntervalReading",
      "type": "string"
    },
    "LangText": {
      "additionalProperties": false,
      "description": "A free-text field with its language, per §1.6's hard rule.",
      "properties": {
        "lang": {
          "maxLength": 16,
          "minLength": 2,
          "title": "Lang",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "lang"
      ],
      "title": "LangText",
      "type": "object"
    },
    "MultiLangText": {
      "additionalProperties": false,
      "description": "A label carried in several languages at once (topic titles, concept labels).",
      "properties": {
        "values": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "title": "Values",
          "type": "object"
        }
      },
      "required": [
        "values"
      ],
      "title": "MultiLangText",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "``{skill_version, model_id, run_id, timestamp}`` (§3.2, §4.1).\n\n``model_id`` is ``None`` for purely deterministic producers (A1, scripts): recording\n\"no model was involved\" is itself an audit fact, and D10 makes it a meaningful one.",
      "properties": {
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "skill_version": {
          "pattern": "^[A-Za-z0-9]+-\\d+\\.\\d+\\.\\d+$",
          "title": "Skill Version",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "skill_version",
        "run_id",
        "timestamp"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RGate": {
      "additionalProperties": false,
      "description": "Deterministic statistical gate (§3.3 S6).  Runs before any editorial agent sees the\ncandidate, which is the structural half of D8.\n\nThe gate is a reader of the signed-difference interval; ``reading`` says\nwhich of the five R-2.2 readings the interval supported.  It lives here rather than in\n``metrics`` because it depends on the thresholds version, not only on the data.",
      "properties": {
        "failed_checks": {
          "items": {
            "type": "string"
          },
          "title": "Failed Checks",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "reading": {
          "anyOf": [
            {
              "$ref": "#/$defs/IntervalReading"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "thresholds_version": {
          "minLength": 1,
          "title": "Thresholds Version",
          "type": "string"
        }
      },
      "required": [
        "passed",
        "thresholds_version"
      ],
      "title": "RGate",
      "type": "object"
    },
    "RecommendedVisual": {
      "description": "Controlled vocabulary mapped onto the §2.2 component list, so S6 cannot invent a\nchart the frontend does not have.  Each member names the component(s) it renders in.",
      "enum": [
        "paired_ranked_concepts",
        "prevalence_bars",
        "source_category_stack",
        "stance_distribution",
        "voice_structure_graph",
        "term_pair_cards",
        "dual_timeline",
        "homogeneity_clusters",
        "shared_ground_panel",
        "silence_panel"
      ],
      "title": "RecommendedVisual",
      "type": "string"
    },
    "ResamplingSpec": {
      "additionalProperties": false,
      "description": "How the interval was produced — enough to re-run it exactly.",
      "properties": {
        "n_resamples": {
          "minimum": 1,
          "title": "N Resamples",
          "type": "integer"
        },
        "scheme": {
          "minLength": 1,
          "title": "Scheme",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "required": [
        "n_resamples",
        "scheme"
      ],
      "title": "ResamplingSpec",
      "type": "object"
    },
    "Selection": {
      "additionalProperties": false,
      "properties": {
        "constraint_roles": {
          "items": {
            "type": "string"
          },
          "title": "Constraint Roles",
          "type": "array"
        },
        "rank": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank"
        },
        "status": {
          "$ref": "#/$defs/AngleStatus"
        }
      },
      "required": [
        "status"
      ],
      "title": "Selection",
      "type": "object"
    },
    "SupportCount": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A candidate angle across its whole life: A1 output -> R-gate -> S6 -> G2.",
  "properties": {
    "angle_id": {
      "title": "Angle Id",
      "type": "string"
    },
    "angle_type": {
      "$ref": "#/$defs/AngleType"
    },
    "blind_spot_check": {
      "anyOf": [
        {
          "$ref": "#/$defs/BlindSpotCheck"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "comparison": {
      "$ref": "#/$defs/Comparison"
    },
    "editorial": {
      "anyOf": [
        {
          "$ref": "#/$defs/Editorial"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "exceptions": {
      "items": {
        "type": "string"
      },
      "title": "Exceptions",
      "type": "array"
    },
    "gate_status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gate Status"
    },
    "merged_into": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Merged Into"
    },
    "metrics": {
      "$ref": "#/$defs/AngleMetrics"
    },
    "origin": {
      "$ref": "#/$defs/AngleOrigin"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "r_gate": {
      "$ref": "#/$defs/RGate"
    },
    "selection": {
      "$ref": "#/$defs/Selection"
    },
    "semantic_cluster_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Semantic Cluster Id"
    },
    "supporting_observations": {
      "items": {
        "type": "string"
      },
      "title": "Supporting Observations",
      "type": "array"
    },
    "topic_id": {
      "title": "Topic Id",
      "type": "string"
    }
  },
  "required": [
    "angle_id",
    "topic_id",
    "origin",
    "angle_type",
    "comparison",
    "metrics",
    "r_gate",
    "selection",
    "provenance"
  ],
  "title": "CandidateAngle",
  "type": "object"
}

    "FindingKind": {
      "description": "The shapes a Q×A finding can take (value_chain.md \"The Q×A model\").\n\nSince the analyze refactor the emitted kinds are ``consensus`` /\n``divergence`` / ``attention_gap``, and a question emits at most one of them.  An\nattention gap (qa-0.4.0 semantics) asserts one side barely addresses the question\n(rate below the ``silent_max_rate`` threshold) while the other side addresses it\nsubstantially more — the blindspot-like reading; a mere rate difference between two\nsides that both plainly speak is not a finding.  It is first-class (it can carry an\nangle) and its angle always marks the quiet side; when the quiet side has zero\naddressed clusters the finding sets ``total_silence`` and is worded as\nannotation-layer silence.  ``blindspot`` and ``coverage_gap`` are no longer emitted\nbut stay members — historical runs on disk reference them (append-only).",
      "enum": [
        "consensus",
        "divergence",
        "attention_gap",
        "blindspot",
        "coverage_gap"
      ],
      "title": "FindingKind",
      "type": "string"
    },
    "FindingStrength": {
      "description": "The analyze stage's verdict on one finding at the current corpus size (V-3).\n\nComputed by plain Python against versioned thresholds; the writer cannot move it.\n``unsupported`` findings may not be asserted in prose or charts.",
      "enum": [
        "supported",
        "weak",
        "unsupported"
      ],
      "title": "FindingStrength",
      "type": "string"
    },
    "LangText": {
      "additionalProperties": false,
      "description": "A free-text field with its language, per §1.6's hard rule.",
      "properties": {
        "lang": {
          "maxLength": 16,
          "minLength": 2,
          "title": "Lang",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "lang"
      ],
      "title": "LangText",
      "type": "object"
    },

          "type": "array"
        },
        "stages": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Stages",
          "type": "array"
        }
      },
      "required": [
        "model_id",
        "stages",
        "run_ids"
      ],
      "title": "WorkerAttribution",
      "type": "object"
    }
  },

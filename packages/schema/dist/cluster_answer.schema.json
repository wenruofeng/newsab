{
  "$comment": "GENERATED by newsab_schema.export — do not edit. Definition site: packages/schema/newsab_schema/ | blueprint value_chain.md Q×A model / V-1 | status: settled",
  "$defs": {
    "LangText": {
      "additionalProperties": false,
      "description": "A free-text field with its language, per §1.6's hard rule.",
      "properties": {
        "lang": {
          "maxLength": 16,
          "minLength": 2,
          "title": "Lang",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "lang"
      ],
      "title": "LangText",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "``{skill_version, model_id, run_id, timestamp}`` (§3.2, §4.1).\n\n``model_id`` is ``None`` for purely deterministic producers (A1, scripts): recording\n\"no model was involved\" is itself an audit fact, and D10 makes it a meaningful one.",
      "properties": {
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "skill_version": {
          "pattern": "^[A-Za-z0-9]+-\\d+\\.\\d+\\.\\d+$",
          "title": "Skill Version",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "skill_version",
        "run_id",
        "timestamp"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One reporting cluster's answer to one question — the annotation atom (V-1).\n\n``addressed=false`` states that this annotation pass found no place in the cluster\nthat answers the question.  It is annotation-layer silence — \"we found no cluster\nthat…\", never \"the words don't exist somewhere\" (non-negotiable 5) — and therefore\ncarries no summary, no category and no anchors.  ``addressed=true`` requires all\nthree at construction time: there is no code path that records an answer and\nattaches its evidence later (non-negotiable 2).",
  "properties": {
    "addressed": {
      "title": "Addressed",
      "type": "boolean"
    },
    "answer_category": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Answer Category"
    },
    "answer_id": {
      "title": "Answer Id",
      "type": "string"
    },
    "answer_summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/LangText"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "evidence": {
      "items": {
        "type": "string"
      },
      "title": "Evidence",
      "type": "array"
    },
    "group_id": {
      "pattern": "^[a-z]{2,5}$",
      "title": "Group Id",
      "type": "string"
    },
    "notes": {
      "anyOf": [
        {
          "$ref": "#/$defs/LangText"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "question_id": {
      "title": "Question Id",
      "type": "string"
    },
    "question_set_version": {
      "minLength": 1,
      "title": "Question Set Version",
      "type": "string"
    },
    "reporting_cluster_id": {
      "title": "Reporting Cluster Id",
      "type": "string"
    },
    "topic_id": {
      "title": "Topic Id",
      "type": "string"
    }
  },
  "required": [
    "answer_id",
    "topic_id",
    "question_id",
    "question_set_version",
    "reporting_cluster_id",
    "group_id",
    "addressed",
    "provenance"
  ],
  "title": "ClusterAnswer",
  "type": "object"
}

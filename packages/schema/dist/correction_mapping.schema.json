{
  "$comment": "GENERATED by newsab_schema.export — do not edit. Definition site: packages/schema/newsab_schema/ | blueprint §3.2 / §4.6 | status: draft",
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "description": "One immutable file, optionally narrowed to a record inside a stream.",
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "record_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Id"
        },
        "run_id": {
          "pattern": "^[a-z][a-z0-9]{0,15}-(?:\\d{12}|\\d{20})-[0-9a-f]{8}$",
          "title": "Run Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "path",
        "sha256"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "LangText": {
      "additionalProperties": false,
      "description": "A free-text field with its language, per §1.6's hard rule.",
      "properties": {
        "lang": {
          "maxLength": 16,
          "minLength": 2,
          "title": "Lang",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "lang"
      ],
      "title": "LangText",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "``{skill_version, model_id, run_id, timestamp}`` (§3.2, §4.1).\n\n``model_id`` is ``None`` for purely deterministic producers (A1, scripts): recording\n\"no model was involved\" is itself an audit fact, and D10 makes it a meaningful one.",
      "properties": {
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "skill_version": {
          "pattern": "^[A-Za-z0-9]+-\\d+\\.\\d+\\.\\d+$",
          "title": "Skill Version",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "skill_version",
        "run_id",
        "timestamp"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Append-only link from an erroneous record/file to its replacement (§3.2).",
  "properties": {
    "correction_id": {
      "pattern": "^COR-[a-z0-9]+(?:-[a-z0-9]+)*-\\d{4,8}$",
      "title": "Correction Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "reason": {
      "$ref": "#/$defs/LangText"
    },
    "replacement": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "superseded": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "topic_id": {
      "title": "Topic Id",
      "type": "string"
    }
  },
  "required": [
    "correction_id",
    "topic_id",
    "superseded",
    "replacement",
    "reason",
    "provenance",
    "timestamp"
  ],
  "title": "CorrectionMapping",
  "type": "object"
}

{
  "$comment": "GENERATED by newsab_schema.export — do not edit. Definition site: packages/schema/newsab_schema/ | blueprint ⑤ / §4.6 | status: draft",
  "$defs": {
    "Annotator": {
      "additionalProperties": false,
      "description": "Who produced a gold label.  ``is_founder`` matters because ⑤ reserves certain\njudgements (the acceptance scoring) to the user specifically.",
      "properties": {
        "annotator_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Annotator Id",
          "type": "string"
        },
        "is_founder": {
          "default": false,
          "title": "Is Founder",
          "type": "boolean"
        },
        "verifiable_langs": {
          "items": {
            "type": "string"
          },
          "title": "Verifiable Langs",
          "type": "array"
        }
      },
      "required": [
        "annotator_id"
      ],
      "title": "Annotator",
      "type": "object"
    },
    "Dimension": {
      "description": "Generic framing-analysis coding dimensions (S3 layer 1 / S4 track 1).",
      "enum": [
        "problem_definition",
        "responsibility",
        "consequence",
        "stance",
        "proposed_response",
        "actor_role",
        "quoted_voice",
        "terminology",
        "factual_claim"
      ],
      "title": "Dimension",
      "type": "string"
    },
    "GoldAngleScore": {
      "additionalProperties": false,
      "description": "One annotator's verdict on one candidate angle.\n\n``previously_aware`` is the operational form of ⑥'s acceptance criterion \"the user\nwas not already aware of most of them\" — it has to be asked *per angle*, before the\nangle set is seen as a whole, or the answer is hindsight.",
      "properties": {
        "angle_id": {
          "title": "Angle Id",
          "type": "string"
        },
        "annotator_id": {
          "title": "Annotator Id",
          "type": "string"
        },
        "evidence_spot_check": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Spot Check"
        },
        "note": {
          "anyOf": [
            {
              "$ref": "#/$defs/LangText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "previously_aware": {
          "title": "Previously Aware",
          "type": "boolean"
        },
        "scored_at": {
          "format": "date-time",
          "title": "Scored At",
          "type": "string"
        },
        "scores": {
          "$ref": "#/$defs/HumanAngleScore"
        },
        "topic_id": {
          "title": "Topic Id",
          "type": "string"
        }
      },
      "required": [
        "topic_id",
        "angle_id",
        "annotator_id",
        "scores",
        "previously_aware",
        "scored_at"
      ],
      "title": "GoldAngleScore",
      "type": "object"
    },
    "GoldObservation": {
      "additionalProperties": false,
      "description": "A human-authored observation, shaped to compare 1:1 with S4 output (§4.2).",
      "properties": {
        "annotated_at": {
          "format": "date-time",
          "title": "Annotated At",
          "type": "string"
        },
        "annotator_id": {
          "title": "Annotator Id",
          "type": "string"
        },
        "article_id": {
          "title": "Article Id",
          "type": "string"
        },
        "attrs": {
          "additionalProperties": true,
          "title": "Attrs",
          "type": "object"
        },
        "concept_surface": {
          "minLength": 1,
          "title": "Concept Surface",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "dimension": {
          "$ref": "#/$defs/Dimension"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "gold_id": {
          "pattern": "^GOLD-OBS-\\d{6}$",
          "title": "Gold Id",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "$ref": "#/$defs/LangText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "proposition": {
          "$ref": "#/$defs/LangText"
        },
        "subject": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "topic_id": {
          "title": "Topic Id",
          "type": "string"
        }
      },
      "required": [
        "gold_id",
        "topic_id",
        "article_id",
        "dimension",
        "subject",
        "concept_surface",
        "proposition",
        "evidence",
        "annotator_id",
        "annotated_at"
      ],
      "title": "GoldObservation",
      "type": "object"
    },
    "HumanAngleScore": {
      "additionalProperties": false,
      "description": "The four-axis score from blueprint ⑤, 1–5 per axis.",
      "properties": {
        "clear": {
          "maximum": 5,
          "minimum": 1,
          "title": "Clear",
          "type": "integer"
        },
        "defensible": {
          "maximum": 5,
          "minimum": 1,
          "title": "Defensible",
          "type": "integer"
        },
        "distinct": {
          "maximum": 5,
          "minimum": 1,
          "title": "Distinct",
          "type": "integer"
        },
        "interesting": {
          "maximum": 5,
          "minimum": 1,
          "title": "Interesting",
          "type": "integer"
        }
      },
      "required": [
        "interesting",
        "clear",
        "defensible",
        "distinct"
      ],
      "title": "HumanAngleScore",
      "type": "object"
    },
    "LangText": {
      "additionalProperties": false,
      "description": "A free-text field with its language, per §1.6's hard rule.",
      "properties": {
        "lang": {
          "maxLength": 16,
          "minLength": 2,
          "title": "Lang",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "lang"
      ],
      "title": "LangText",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The whole gold set for one topic, at one protocol version.",
  "properties": {
    "angle_scores": {
      "items": {
        "$ref": "#/$defs/GoldAngleScore"
      },
      "title": "Angle Scores",
      "type": "array"
    },
    "annotators": {
      "items": {
        "$ref": "#/$defs/Annotator"
      },
      "minItems": 1,
      "title": "Annotators",
      "type": "array"
    },
    "double_annotated_articles": {
      "items": {
        "type": "string"
      },
      "title": "Double Annotated Articles",
      "type": "array"
    },
    "fully_annotated_articles": {
      "items": {
        "type": "string"
      },
      "title": "Fully Annotated Articles",
      "type": "array"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/GoldObservation"
      },
      "title": "Observations",
      "type": "array"
    },
    "protocol_version": {
      "minLength": 1,
      "title": "Protocol Version",
      "type": "string"
    },
    "set_version": {
      "minLength": 1,
      "title": "Set Version",
      "type": "string"
    },
    "topic_id": {
      "title": "Topic Id",
      "type": "string"
    }
  },
  "required": [
    "topic_id",
    "set_version",
    "protocol_version",
    "annotators"
  ],
  "title": "GoldStandardSet",
  "type": "object"
}

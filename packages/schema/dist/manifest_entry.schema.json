{
  "$comment": "GENERATED by newsab_schema.export — do not edit. Definition site: packages/schema/newsab_schema/ | blueprint §3.2 / §4.6 | status: draft",
  "$defs": {
    "Escalation": {
      "additionalProperties": false,
      "description": "Something the run refused to decide on its own (§3.3 escalation conditions).",
      "properties": {
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "resolved_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved By"
        }
      },
      "required": [
        "kind",
        "detail"
      ],
      "title": "Escalation",
      "type": "object"
    },
    "Gate": {
      "description": "The three human gates (§3.4).",
      "enum": [
        "G1",
        "G2",
        "G3"
      ],
      "title": "Gate",
      "type": "string"
    },
    "GateDecider": {
      "description": "Who actually passed a gate.  ``llm_stand_in`` MUST be surfaced on the published\nrecord (AGENTS.md §8).",
      "enum": [
        "human",
        "llm_stand_in"
      ],
      "title": "GateDecider",
      "type": "string"
    },
    "GateRecord": {
      "additionalProperties": false,
      "description": "Who passed a human gate, and whether a human was actually involved.\n\nAGENTS.md §8: if an LLM stands in for the user at a gate, that fact must reach the\nmanifest *and* the published record.  Making it a required field is how it gets there.",
      "properties": {
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "decided_by": {
          "$ref": "#/$defs/GateDecider"
        },
        "decision": {
          "pattern": "^(approved|rejected|approved_with_changes)$",
          "title": "Decision",
          "type": "string"
        },
        "gate": {
          "$ref": "#/$defs/Gate"
        },
        "note": {
          "anyOf": [
            {
              "$ref": "#/$defs/LangText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stand_in_model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stand In Model Id"
        }
      },
      "required": [
        "gate",
        "decided_by",
        "decided_at",
        "decision"
      ],
      "title": "GateRecord",
      "type": "object"
    },
    "LangText": {
      "additionalProperties": false,
      "description": "A free-text field with its language, per §1.6's hard rule.",
      "properties": {
        "lang": {
          "maxLength": 16,
          "minLength": 2,
          "title": "Lang",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "lang"
      ],
      "title": "LangText",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One stage run (§3.2).",
  "properties": {
    "counters": {
      "additionalProperties": true,
      "title": "Counters",
      "type": "object"
    },
    "escalations": {
      "items": {
        "$ref": "#/$defs/Escalation"
      },
      "title": "Escalations",
      "type": "array"
    },
    "gates": {
      "items": {
        "$ref": "#/$defs/GateRecord"
      },
      "title": "Gates",
      "type": "array"
    },
    "input_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Input Hashes",
      "type": "object"
    },
    "inputs": {
      "items": {
        "type": "string"
      },
      "title": "Inputs",
      "type": "array"
    },
    "judge_scores": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Judge Scores",
      "type": "object"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Id"
    },
    "output_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Output Hashes",
      "type": "object"
    },
    "output_set_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Set Hash"
    },
    "run_id": {
      "pattern": "^[a-z][a-z0-9]{0,15}-(?:\\d{12}|\\d{20})-[0-9a-f]{8}$",
      "title": "Run Id",
      "type": "string"
    },
    "skill_id": {
      "minLength": 1,
      "title": "Skill Id",
      "type": "string"
    },
    "skill_version": {
      "minLength": 1,
      "title": "Skill Version",
      "type": "string"
    },
    "stage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stage"
    },
    "status": {
      "default": "completed",
      "enum": [
        "completed",
        "no_op",
        "stopped"
      ],
      "title": "Status",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "topic_id": {
      "title": "Topic Id",
      "type": "string"
    }
  },
  "required": [
    "skill_id",
    "skill_version",
    "run_id",
    "topic_id",
    "timestamp"

{
  "$comment": "GENERATED by newsab_schema.export — do not edit. Definition site: packages/schema/newsab_schema/ | blueprint §4.2 | status: settled",
  "$defs": {
    "Dimension": {
      "description": "Generic framing-analysis coding dimensions (S3 layer 1 / S4 track 1).",
      "enum": [
        "problem_definition",
        "responsibility",
        "consequence",
        "stance",
        "proposed_response",
        "actor_role",
        "quoted_voice",
        "terminology",
        "factual_claim"
      ],
      "title": "Dimension",
      "type": "string"
    },
    "LangText": {
      "additionalProperties": false,
      "description": "A free-text field with its language, per §1.6's hard rule.",
      "properties": {
        "lang": {
          "maxLength": 16,
          "minLength": 2,
          "title": "Lang",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "lang"
      ],
      "title": "LangText",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "``{skill_version, model_id, run_id, timestamp}`` (§3.2, §4.1).\n\n``model_id`` is ``None`` for purely deterministic producers (A1, scripts): recording\n\"no model was involved\" is itself an audit fact, and D10 makes it a meaningful one.",
      "properties": {
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "skill_version": {
          "pattern": "^[A-Za-z0-9]+-\\d+\\.\\d+\\.\\d+$",
          "title": "Skill Version",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "skill_version",
        "run_id",
        "timestamp"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One local presentation act, in one article, on one dimension.\n\nSmall and many, never a whole-article summary (§4.2): an article dense with framing\nyields 10–30 of these.  Everything a reader eventually sees is aggregated from here,\nwhich is why ``evidence`` is required at construction — there is no code path that\ncreates an observation and attaches evidence later (§3.0 rule 4).",
  "properties": {
    "article_id": {
      "title": "Article Id",
      "type": "string"
    },
    "attrs": {
      "additionalProperties": true,
      "title": "Attrs",
      "type": "object"
    },
    "concept_surface": {
      "minLength": 1,
      "title": "Concept Surface",
      "type": "string"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "dimension": {
      "$ref": "#/$defs/Dimension"
    },
    "evidence": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "observation_id": {
      "title": "Observation Id",
      "type": "string"
    },
    "proposition": {
      "$ref": "#/$defs/LangText"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "subject": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Subject",
      "type": "string"
    },
    "topic_id": {
      "title": "Topic Id",
      "type": "string"
    }
  },
  "required": [
    "observation_id",
    "topic_id",
    "article_id",
    "dimension",
    "subject",
    "concept_surface",
    "proposition",
    "evidence",
    "confidence",
    "provenance"
  ],
  "title": "Observation",
  "type": "object"
}

{
  "$comment": "GENERATED by newsab_schema.export — do not edit. Definition site: packages/schema/newsab_schema/ | blueprint value_chain.md stage 8 | status: settled",
  "$defs": {
    "HumanApproval": {
      "additionalProperties": false,
      "description": "A human decision authorizing a final page or lifecycle operation.\n\nThis is deliberately human-only.  The scope stage has a separately recorded and\nexplicitly limited stand-in path; final review and publication lifecycle changes do\nnot acquire that authority by reuse.",
      "properties": {
        "approval_id": {
          "pattern": "^APR-[a-z0-9]+(?:-[a-z0-9]+)*-[0-9a-f]{8}$",
          "title": "Approval Id",
          "type": "string"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "decision": {
          "const": "approved",
          "default": "approved",
          "title": "Decision",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "$ref": "#/$defs/LangText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reviewer_id": {
          "minLength": 1,
          "title": "Reviewer Id",
          "type": "string"
        }
      },
      "required": [
        "approval_id",
        "reviewer_id",
        "decided_at"
      ],
      "title": "HumanApproval",
      "type": "object"
    },
    "LangText": {
      "additionalProperties": false,
      "description": "A free-text field with its language, per §1.6's hard rule.",
      "properties": {
        "lang": {
          "maxLength": 16,
          "minLength": 2,
          "title": "Lang",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "lang"
      ],
      "title": "LangText",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "``{skill_version, model_id, run_id, timestamp}`` (§3.2, §4.1).\n\n``model_id`` is ``None`` for purely deterministic producers (A1, scripts): recording\n\"no model was involved\" is itself an audit fact, and D10 makes it a meaningful one.",
      "properties": {
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "skill_version": {
          "pattern": "^[A-Za-z0-9]+-\\d+\\.\\d+\\.\\d+$",
          "title": "Skill Version",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "skill_version",
        "run_id",
        "timestamp"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "PublicationEventType": {
      "description": "Append-only lifecycle transitions for an immutable publication record.",
      "enum": [
        "publish",
        "supersede",
        "withdraw",
        "restore",
        "audit_delete"
      ],
      "title": "PublicationEventType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One append-only lifecycle transition for an immutable publication.",
  "properties": {
    "approval": {
      "$ref": "#/$defs/HumanApproval"
    },
    "event_id": {
      "pattern": "^EVT-\\d{14}-[0-9a-f]{8}$",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/PublicationEventType"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "previous_event_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Event Hash"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "publication_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Publication Hash",
      "type": "string"
    },
    "publication_id": {
      "pattern": "^PUB-[a-z0-9]+(?:-[a-z0-9]+)*-[0-9a-f]{12}$",
      "title": "Publication Id",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/LangText"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "replacement_publication_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Replacement Publication Hash"
    },
    "replacement_publication_id": {
      "anyOf": [
        {
          "pattern": "^PUB-[a-z0-9]+(?:-[a-z0-9]+)*-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Replacement Publication Id"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "publication_id",
    "publication_hash",
    "approval",
    "occurred_at",
    "provenance"
  ],
  "title": "PublicationEvent",
  "type": "object"
}

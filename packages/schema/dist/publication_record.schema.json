{
  "$comment": "GENERATED by newsab_schema.export — do not edit. Definition site: packages/schema/newsab_schema/ | blueprint value_chain.md stage 8 | status: settled",
  "$defs": {
    "DataAsset": {
      "additionalProperties": false,
      "description": "One content-addressed, language-neutral data island the page bytes reference.\n\nThese files are content, not chrome — they enter the candidate bundle's closed\nfile list, the bundle fingerprint covers their bytes, and this record pins them by\nname and hash.  The filename embeds the content hash, so the approved page bytes\n(which reference each asset by that name) transitively bind the asset bytes.",
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9-]*\\.[0-9a-f]{16}\\.json$",
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "name",
        "url",
        "sha256"
      ],
      "title": "DataAsset",
      "type": "object"
    },
    "LangText": {
      "additionalProperties": false,
      "description": "A free-text field with its language, per §1.6's hard rule.",
      "properties": {
        "lang": {
          "maxLength": 16,
          "minLength": 2,
          "title": "Lang",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "lang"
      ],
      "title": "LangText",
      "type": "object"
    },
    "LocaleBundle": {
      "additionalProperties": false,
      "description": "The final static page for one supported reader locale.",
      "properties": {
        "locale": {
          "title": "Locale",
          "type": "string"
        },
        "page_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Page Hash",
          "type": "string"
        },
        "page_url": {
          "title": "Page Url",
          "type": "string"
        }
      },
      "required": [
        "locale",
        "page_url",
        "page_hash"
      ],
      "title": "LocaleBundle",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "``{skill_version, model_id, run_id, timestamp}`` (§3.2, §4.1).\n\n``model_id`` is ``None`` for purely deterministic producers (A1, scripts): recording\n\"no model was involved\" is itself an audit fact, and D10 makes it a meaningful one.",
      "properties": {
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "skill_version": {
          "pattern": "^[A-Za-z0-9]+-\\d+\\.\\d+\\.\\d+$",
          "title": "Skill Version",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "skill_version",
        "run_id",
        "timestamp"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "PublicationReview": {
      "additionalProperties": false,
      "description": "Touchpoint-two approval of the exact localized page bytes.",
      "properties": {
        "approval_id": {
          "pattern": "^APR-[a-z0-9]+(?:-[a-z0-9]+)*-[0-9a-f]{8}$",
          "title": "Approval Id",
          "type": "string"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "decision": {
          "const": "approved",
          "default": "approved",
          "title": "Decision",
          "type": "string"
        },
        "locale": {
          "title": "Locale",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "$ref": "#/$defs/LangText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "page_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Page Hash",
          "type": "string"
        },
        "reviewed_locales": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed Locales"
        },
        "reviewer_id": {
          "minLength": 1,
          "title": "Reviewer Id",
          "type": "string"
        }
      },
      "required": [
        "approval_id",
        "reviewer_id",
        "decided_at",
        "locale",
        "page_hash"
      ],
      "title": "PublicationReview",
      "type": "object"
    },
    "ReviewedEquivalence": {
      "additionalProperties": false,
      "description": "Why a re-prepared publication still carries the bytes a human approved.\n\n``prepare`` normally re-renders the reviewed locale set and demands the user's\nexact bytes back.  The site-wide locale backfill cannot: it re-prepares an\nalready-approved publication against the topic's current editorial run and today's\nrenderer, purely to ship languages the site has since learned, so the run's own\nprovenance line and the renderer's chrome have both moved for reasons the user\nnever reviewed.  That path proves the same thing in two mechanical layers instead\n(``newsab_publish.reviewed_equivalence``): the approved *content* is identical in\nevery reviewed language, and the rendered bytes differ only inside a closed,\ncode-owned whitelist.\n\nThis record is the proof's receipt.  ``redacted_digest`` is the hash both renders\nproduced once the whitelist was erased — a later ``verify-candidate`` re-renders the\nreviewed set and requires that same digest back, so the proof replays without needing\nthe superseded bundle.  Its presence is also the audit trail: a publication that\nreproduces the signed bytes exactly does not carry one.",
      "properties": {
        "candidate_page_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Candidate Page Hash",
          "type": "string"
        },
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "redacted_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Redacted Digest",
          "type": "string"
        },
        "reviewed_locale": {
          "title": "Reviewed Locale",
          "type": "string"
        },
        "signed_page_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Signed Page Hash",
          "type": "string"
        },
        "signed_page_run_id": {
          "minLength": 1,
          "title": "Signed Page Run Id",
          "type": "string"
        },
        "whitelist_version": {
          "minLength": 1,
          "title": "Whitelist Version",
          "type": "string"
        },
        "whitelisted_differences": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Whitelisted Differences",
          "type": "object"
        }
      },
      "required": [
        "reviewed_locale",
        "signed_page_hash",
        "signed_page_run_id",
        "candidate_page_hash",
        "redacted_digest",
        "whitelist_version",
        "content_digest"
      ],
      "title": "ReviewedEquivalence",
      "type": "object"
    },
    "ShareAsset": {
      "additionalProperties": false,
      "description": "One angle's public-safe share landing, generated from the same pinned page.\n\nThe landing page is what the share button hands a system share sheet and what a\ncrawler reads for the per-angle ``og:title`` / ``og:description``.  Producers up to\n``publish-0.7.0`` also drew one SVG card per angle and locale and pinned it here as\n``url`` / ``sha256`` (retired: no platform renders SVG as a card image, and the\nrelease had already pointed every crawler at the site's PNG card).\nA record minted since carries the landing alone and leaves the image fields ``None``;\nthe historical records keep theirs, so a verifier must accept both shapes.",
      "properties": {
        "height": {
          "anyOf": [
            {
              "const": 630,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "landing_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Landing Sha256",
          "type": "string"
        },
        "landing_url": {
          "title": "Landing Url",
          "type": "string"
        },
        "locale": {
          "title": "Locale",
          "type": "string"
        },
        "mime_type": {
          "anyOf": [
            {
              "const": "image/svg+xml",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mime Type"
        },
        "question_id": {
          "title": "Question Id",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "width": {
          "anyOf": [
            {
              "const": 1200,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        }
      },
      "required": [
        "locale",
        "question_id",
        "landing_url",
        "landing_sha256"
      ],
      "title": "ShareAsset",
      "type": "object"
    },
    "SponsorAttribution": {
      "additionalProperties": false,
      "description": "Public sponsor credit; control credentials never belong in this record.",
      "properties": {
        "anonymous": {
          "default": false,
          "title": "Anonymous",
          "type": "boolean"
        },
        "display_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        }
      },
      "title": "SponsorAttribution",
      "type": "object"
    },
    "TopicRunPin": {
      "additionalProperties": false,
      "description": "One cross-root dependency edge from a publication to a topic run.",
      "properties": {
        "artifact_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Artifact Fingerprint",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "stage": {
          "enum": [
            "scope",
            "corpus",
            "questions",
            "answers",
            "normalization",
            "analysis",
            "page"
          ],
          "title": "Stage",
          "type": "string"
        },
        "topic_id": {
          "title": "Topic Id",
          "type": "string"
        }
      },
      "required": [
        "topic_id",
        "stage",
        "run_id",
        "artifact_fingerprint"
      ],
      "title": "TopicRunPin",
      "type": "object"
    },
    "WorkerAttribution": {
      "additionalProperties": false,
      "description": "One AI model's actual stage contribution, backed by run ids.",
      "properties": {
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "run_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Run Ids",
          "type": "array"
        },
        "stages": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Stages",
          "type": "array"
        }
      },
      "required": [
        "model_id",
        "stages",
        "run_ids"
      ],
      "title": "WorkerAttribution",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "An immutable, reviewed release candidate produced by stage 8.\n\nIt intentionally carries neither ``status`` nor ``published_at``.  Before a publish\nevent it means \"approved but not published\"; the event timestamp is the only\npublication time.  This separation prevents a lifecycle change from rewriting the\nreviewed bytes or their provenance.",
  "properties": {
    "audit_run_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9]{0,15}-(?:\\d{12}|\\d{20})-[0-9a-f]{8}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audit Run Id"
    },
    "data_assets": {
      "items": {
        "$ref": "#/$defs/DataAsset"
      },
      "title": "Data Assets",
      "type": "array"
    },
    "default_locale": {
      "title": "Default Locale",
      "type": "string"
    },
    "locales": {
      "items": {
        "$ref": "#/$defs/LocaleBundle"
      },
      "minItems": 1,
      "title": "Locales",
      "type": "array"
    },
    "page_run_id": {
      "pattern": "^[a-z][a-z0-9]{0,15}-(?:\\d{12}|\\d{20})-[0-9a-f]{8}$",
      "title": "Page Run Id",
      "type": "string"
    },
    "prepared_at": {
      "format": "date-time",
      "title": "Prepared At",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "public_bundle_fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Public Bundle Fingerprint",
      "type": "string"
    },
    "publication_id": {
      "pattern": "^PUB-[a-z0-9]+(?:-[a-z0-9]+)*-[0-9a-f]{12}$",
      "title": "Publication Id",
      "type": "string"
    },
    "render_input_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Render Input Hashes",
      "type": "object"
    },
    "review": {
      "$ref": "#/$defs/PublicationReview"
    },
    "reviewed_equivalence": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReviewedEquivalence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_closure": {
      "items": {
        "$ref": "#/$defs/TopicRunPin"
      },
      "title": "Run Closure",
      "type": "array"
    },
    "share_assets": {
      "items": {
        "$ref": "#/$defs/ShareAsset"
      },
      "title": "Share Assets",
      "type": "array"
    },
    "site_metadata_fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Site Metadata Fingerprint",
      "type": "string"
    },
    "site_metadata_version": {
      "pattern": "^site-metadata-\\d+\\.\\d+\\.\\d+$",
      "title": "Site Metadata Version",
      "type": "string"
    },
    "sponsor": {
      "$ref": "#/$defs/SponsorAttribution"
    },
    "submission_archive_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Submission Archive Hash"
    },
    "submission_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Submission Id"
    },
    "theme_registry_fingerprint": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Theme Registry Fingerprint"
    },
    "theme_registry_version": {
      "anyOf": [
        {
          "pattern": "^theme-tokens-\\d+\\.\\d+\\.\\d+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Theme Registry Version"
    },
    "theme_token": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Theme Token"
    },
    "topic_id": {
      "title": "Topic Id",
      "type": "string"
    },
    "workers": {
      "items": {
        "$ref": "#/$defs/WorkerAttribution"
      },
      "minItems": 1,
      "title": "Workers",
      "type": "array"
    }
  },
  "required": [
    "publication_id",
    "topic_id",
    "page_run_id",
    "run_closure",
    "review",
    "default_locale",
    "locales",
    "sponsor",
    "workers",
    "site_metadata_version",
    "site_metadata_fingerprint",
    "public_bundle_fingerprint",
    "prepared_at",
    "provenance"
  ],
  "title": "PublicationRecord",
  "type": "object"
}

{
  "$comment": "GENERATED by newsab_schema.export — do not edit. Definition site: packages/schema/newsab_schema/ | blueprint §3.3 S0 / §4.6 | status: draft",
  "$defs": {
    "Contributor": {
      "additionalProperties": false,
      "description": "A human who put this topic forward and answers for it.\n\nIdentity only — this is who a reader can hold responsible, not a role in the\npipeline.  Both fields are optional: an external contributor may stay anonymous, and\na contributor who does not want a public address simply carries no ``contact``.",
      "properties": {
        "contact": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contact"
        },
        "name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        }
      },
      "title": "Contributor",
      "type": "object"
    },
    "GateDecider": {
      "description": "Who actually passed a gate.  ``llm_stand_in`` MUST be surfaced on the published\nrecord (AGENTS.md §8).",
      "enum": [
        "human",
        "llm_stand_in"
      ],
      "title": "GateDecider",
      "type": "string"
    },
    "Group": {
      "additionalProperties": false,
      "description": "One semantically defined side of a comparison.\n\nMembership is a collection-stage judgement against ``definition``.  It is deliberately\nnot derived from a country/language tuple: a valid side may span countries, mix source\nlanguages, or be defined as \"English coverage\" versus \"all other languages\".\n``prefix`` is the stable article-ID namespace; ``label`` is short reader-facing copy.",
      "properties": {
        "definition": {
          "$ref": "#/$defs/MultiLangText"
        },
        "group_id": {
          "pattern": "^[a-z]{2,5}$",
          "title": "Group Id",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/MultiLangText"
        },
        "prefix": {
          "pattern": "^[A-Z]{2,5}$",
          "title": "Prefix",
          "type": "string"
        },
        "short_label": {
          "$ref": "#/$defs/MultiLangText"
        }
      },
      "required": [
        "group_id",
        "prefix",
        "label",
        "short_label",
        "definition"
      ],
      "title": "Group",
      "type": "object"
    },
    "LangText": {
      "additionalProperties": false,
      "description": "A free-text field with its language, per §1.6's hard rule.",
      "properties": {
        "lang": {
          "maxLength": 16,
          "minLength": 2,
          "title": "Lang",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "lang"
      ],
      "title": "LangText",
      "type": "object"
    },
    "MultiLangText": {
      "additionalProperties": false,
      "description": "A label carried in several languages at once (topic titles, concept labels).",
      "properties": {
        "values": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "title": "Values",
          "type": "object"
        }
      },
      "required": [
        "values"
      ],
      "title": "MultiLangText",
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "description": "The time window the topic is frozen to.  ``end=None`` means \"still running\".",
      "properties": {
        "end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start"
      ],
      "title": "Period",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "``{skill_version, model_id, run_id, timestamp}`` (§3.2, §4.1).\n\n``model_id`` is ``None`` for purely deterministic producers (A1, scripts): recording\n\"no model was involved\" is itself an audit fact, and D10 makes it a meaningful one.",
      "properties": {
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "skill_version": {
          "pattern": "^[A-Za-z0-9]+-\\d+\\.\\d+\\.\\d+$",
          "title": "Skill Version",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "skill_version",
        "run_id",
        "timestamp"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "QuestionSeed": {
      "additionalProperties": false,
      "description": "One touchpoint-one question approved for annotate's input packet.\n\nDiscovery origin deliberately does not travel here.  The annotator sees only the\nquestion's meaning and whether a human made it mandatory; audience-source notes remain\nin the scope-only candidate review artifact.",
      "properties": {
        "mandate": {
          "$ref": "#/$defs/SeedQuestionMandate",
          "default": "reference"
        },
        "seed_id": {
          "pattern": "^SQ-[0-9]{3}$",
          "title": "Seed Id",
          "type": "string"
        },
        "text": {
          "$ref": "#/$defs/MultiLangText"
        }
      },
      "required": [
        "seed_id",
        "text"
      ],
      "title": "QuestionSeed",
      "type": "object"
    },
    "RiskLevel": {
      "description": "S0 ``risk_level``; ``high`` forces the G3 human gate (§3.3 S8-L2).",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "ScopeApproval": {
      "additionalProperties": false,
      "description": "Touchpoint #1, bound to the exact scope fields that were approved.\n\nA model may stand in only when the user explicitly requests it.  The distinction is\nstructural because a stand-in may approve reference seeds but cannot create a\nmust-answer instruction for annotate.",
      "properties": {
        "approved_at": {
          "format": "date-time",
          "title": "Approved At",
          "type": "string"
        },
        "approved_by": {
          "minLength": 1,
          "title": "Approved By",
          "type": "string"
        },
        "decided_by": {
          "$ref": "#/$defs/GateDecider",
          "default": "human"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "scope_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Scope Hash",
          "type": "string"
        },
        "stand_in_model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stand In Model Id"
        }
      },
      "required": [
        "approved_by",
        "approved_at",
        "scope_hash"
      ],
      "title": "ScopeApproval",
      "type": "object"
    },
    "SeedQuestionMandate": {
      "description": "Touchpoint-one authority attached to an approved scope question.\n\n``reference`` lets annotate use or discard the seed on semantic grounds.\n``required`` compels annotate to include a semantically equivalent question, but gives\nthat question no privilege in analysis or editorial selection.",
      "enum": [
        "reference",
        "required"
      ],
      "title": "SeedQuestionMandate",
      "type": "string"
    },
    "TopicStatus": {
      "description": "§1.4 topic lifecycle.",
      "enum": [
        "candidate",
        "active",
        "archived"
      ],
      "title": "TopicStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "S0 output; the object gate G1 approves (§3.3 S0).\n\nG1 approves *scope and risk*, never a conclusion — which is why this record has no\nfield for an expected finding, and why ``seed_questions`` is explicitly documented as\nretrieval-only (D9).",
  "properties": {
    "angle_carryover": {
      "default": "inherit",
      "enum": [
        "inherit",
        "recheck"
      ],
      "title": "Angle Carryover",
      "type": "string"
    },
    "cluster_threshold": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cluster Threshold"
    },
    "contributors": {
      "items": {
        "$ref": "#/$defs/Contributor"
      },
      "title": "Contributors",
      "type": "array"
    },
    "exclude": {
      "items": {
        "type": "string"
      },
      "title": "Exclude",
      "type": "array"
    },
    "expected_silence": {
      "items": {
        "type": "string"
      },
      "title": "Expected Silence",
      "type": "array"
    },
    "groups": {
      "items": {
        "$ref": "#/$defs/Group"
      },
      "minItems": 2,
      "title": "Groups",
      "type": "array"
    },
    "include": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Include",
      "type": "array"
    },
    "lead": {
      "anyOf": [
        {
          "$ref": "#/$defs/MultiLangText"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "period": {
      "$ref": "#/$defs/Period"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "question_seeds": {
      "items": {
        "$ref": "#/$defs/QuestionSeed"
      },
      "title": "Question Seeds",
      "type": "array"
    },
    "review_locale": {
      "anyOf": [
        {
          "minLength": 2,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Locale"
    },
    "review_stand_in_model_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Stand In Model Id"
    },
    "risk_level": {
      "$ref": "#/$defs/RiskLevel",
      "default": "medium"
    },
    "scope_approval": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScopeApproval"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "seed_questions": {
      "items": {
        "$ref": "#/$defs/LangText"
      },
      "title": "Seed Questions",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/TopicStatus",
      "default": "candidate"
    },
    "target_clusters_per_group": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Target Clusters Per Group",
      "type": "object"
    },
    "title": {
      "$ref": "#/$defs/MultiLangText"
    },
    "topic_id": {
      "title": "Topic Id",
      "type": "string"
    },
    "type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Type"
    }
  },
  "required": [
    "topic_id",
    "title",
    "groups",
    "period",
    "include",
    "provenance"
  ],
  "title": "TopicManifest",
  "type": "object"
}
